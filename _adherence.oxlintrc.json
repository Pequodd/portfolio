{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/patterns/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono|Golos Text))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono, Golos Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|index|className|style|key|ref|className|style|children)$/]",
        "message": "<CaseBlock> doesn't accept that prop. Declared props: label, children, index, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseShots'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|shots|index|className|style|key|ref|className|style|children)$/]",
        "message": "<CaseShots> doesn't accept that prop. Declared props: variant, shots, index, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseShots'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wide|pair)$/]",
        "message": "<CaseShots> variant must be one of 'wide' | 'pair'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|name|stack|title|href|size|ratio|cover|index|className|style|key|ref|className|style|children)$/]",
        "message": "<FeedItem> doesn't accept that prop. Declared props: number, name, stack, title, href, size, ratio, cover, index, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<FilterPill> doesn't accept that prop. Declared props: children, active, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:line|contacts|cta|ctaHref|className|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: line, contacts, cta, ctaHref, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|filters|active|onFilter|count|href|className|style|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: mark, filters, active, onFilter, count, href, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|caption|strap|second|media|mediaSize|wordmark|className|style|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: lead, caption, strap, second, media, mediaSize, wordmark, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meta'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|mono|tone|as|className|style|key|ref|className|style|children)$/]",
        "message": "<Meta> doesn't accept that prop. Declared props: children, mono, tone, as, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meta'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:meta|ink|inactive|inverse)$/]",
        "message": "<Meta> tone must be one of 'meta' | 'ink' | 'inactive' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|name|stack|className|style|key|ref|className|style|children)$/]",
        "message": "<MetaRow> doesn't accept that prop. Declared props: number, name, stack, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NextCase'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|number|title|href|className|style|key|ref|className|style|children)$/]",
        "message": "<NextCase> doesn't accept that prop. Declared props: label, number, title, href, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|inverse|className|style|key|ref|className|style|children)$/]",
        "message": "<PillButton> doesn't accept that prop. Declared props: children, href, inverse, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plinth'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<Plinth> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RenderPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:ratio|size|label|className|style|key|ref|className|style|children)$/]",
        "message": "<RenderPlaceholder> doesn't accept that prop. Declared props: ratio, size, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reveal'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|as|className|style|key|ref|className|style|children)$/]",
        "message": "<Reveal> doesn't accept that prop. Declared props: children, index, as, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|ghost|as|className|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: text, ghost, as, className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
